# 本地开发 — API 经 Vite 代理转发（见 vite.config.ts server.proxy）
VITE_API_BASE_URL=/api
# 后端告警模块路径前缀（Apifox: /api/v1/alarms）
VITE_API_V1_PREFIX=/v1

# API 代理目标（改这里后需重启 npm run dev）
# 公网部署：http://47.108.169.152:8089 （Laravel）
VITE_DEV_API_PROXY=http://47.108.169.152:8089

# 数字孪生：false=只走真实后端，true=接口失败时降级 Mock
VITE_SIMULATION_MOCK=false
# natapp：VITE_DEV_API_PROXY=http://u6a9ea67.natappfree.cc
# 本机后端：VITE_DEV_API_PROXY=http://localhost:8000

# Laravel Reverb 本地联调（仅本机后端 + reverb:start 同时运行时取消注释）
